# Copy to .env.local; never commit real credentials.
MINIMAX_API_KEY=
# Set these to the endpoint/model available with your own MiniMax account.
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2970
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=minimax_sdd
# PowerContext uses its local SDK and SQLiteProfile, not an HTTP server.
# Each demo run creates a fresh .runtime/<run>/progress.sqlite automatically.
